{
  "name": "lumen-launcher",
  "version": "1.3.0",
  "description": "A modern Minecraft launcher with mod and modpack management",
  "main": "./dist/main/index.js",
  "author": "NathanKaz",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run.js electron-vite dev",
    "build": "node scripts/run.js build",
    "typecheck": "node scripts/run.js tsc --noEmit",
    "preview": "node scripts/run.js electron-vite preview",
    "dev:web": "node scripts/run.js vite --config vite.preview.config.ts",
    "dist": "node scripts/run.js dist",
    "dist:win": "node scripts/run.js dist --win",
    "dist:mac": "node scripts/run.js dist --mac",
    "dist:linux": "node scripts/run.js dist --linux",
    "dist:all": "node scripts/dist-all.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "fs-extra": "^11.2.0",
    "lucide-react": "^0.451.0",
    "prismarine-nbt": "^2.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "framer-motion": "^11.11.9",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.lumenlauncher.app",
    "productName": "Lumen Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "icon": "build/icon.png",
    "artifactName": "Lumen-Launcher-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Game",
      "maintainer": "NathanKaz <nathankaz@example.com>"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Lumen-Launcher-${version}-win.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games"
    }
  }
}
