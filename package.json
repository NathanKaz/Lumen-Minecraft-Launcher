{
  "name": "neon-launcher",
  "version": "1.0.0",
  "description": "Красивый лаунчер Minecraft с установкой модов и сборок",
  "main": "./dist/main/index.js",
  "author": "NathanKaz",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run.js electron-vite dev",
    "build": "node scripts/run.js build",
    "typecheck": "node scripts/run.js tsc --noEmit",
    "preview": "node scripts/run.js electron-vite preview",
    "dev:web": "node scripts/run.js vite --config vite.preview.config.ts",
    "dist": "node scripts/run.js dist"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "fs-extra": "^11.2.0",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "framer-motion": "^11.11.9",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.neonlauncher.app",
    "productName": "Neon Launcher",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Game",
      "maintainer": "NathanKaz <nathankaz@example.com>"
    },
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.games"
    }
  }
}
